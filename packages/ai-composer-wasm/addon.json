{
  "id": "official.ai-composer",
  "name": "Smart Email Composer (Local Transformers & WASM)",
  "version": "1.0.0",
  "runtime": "frontend",
  "description": "Compose and polish emails using client-side Transformers.js neural models and lightweight WASM running 100% in your browser.",
  "permissions": ["ui:compose_actions", "compose:insert_text"],
  "frontend": {
    "entry": "ui/index.js",
    "slots": ["compose_actions"],
    "requires_coop_coep": false
  },
  "config_schema": [
    {
      "key": "engine",
      "type": "select",
      "options": ["Transformers.js (Neural SLM)", "Fast Local WASM"],
      "default": "Transformers.js (Neural SLM)",
      "label": "Inference Engine"
    },
    {
      "key": "default_tone",
      "type": "select",
      "options": ["Professional", "Friendly", "Concise", "Urgent", "Formal", "Casual"],
      "default": "Professional",
      "label": "Default Tone"
    },
    {
      "key": "default_length",
      "type": "select",
      "options": ["Standard", "Concise", "Detailed"],
      "default": "Standard",
      "label": "Default Length"
    }
  ]
}
